{
  "window.zoomLevel": 1,
  "workbench.sideBar.location": "left",
  "workbench.list.defaultFindMode": "highlight",
  "workbench.list.typeNavigationMode": "automatic",
  "workbench.list.automaticKeyboardNavigation": false,
  "workbench.editor.enablePreview": false,
  "workbench.startupEditor": "none",

  // テーマ
  "workbench.colorTheme": "GitHub Dark",
  "editor.tokenColorCustomizations": {
    "[Night Owl (No Italics)]": {
      "textMateRules": [
        {
          "scope": [
            "entity.name.function",
            "support.function",
            "meta.function-call.go"
          ],
          "settings": {
            "foreground": "#82AAFF" // 関数名の色
          }
        },
        {
          "scope": [
            "variable",
            "variable.other.readwrite.go",
          ],
          "settings": {
            "foreground": "#aee189" // 変数名の色
          }
        }
      ]
    }
  },

  "application.shellEnvironmentResolutionTimeout": 100,
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "extensions.ignoreRecommendations": true,
  "redhat.telemetry.enabled": true,
  "update.showReleaseNotes": false,


  // ミニマップは非表示
  "editor.fontSize": 14,
  "editor.minimap.enabled": false,
  "editor.tabCompletion": "on",
  "editor.detectIndentation": false,
  "editor.cursorStyle": "line",
  "editor.lineNumbers": "on",
  "editor.wordSeparators": "/\\()\"':,.;<>~!@#$%^&*|+=[]{}`?-",
  "editor.wordWrap": "off",
  "editor.tabSize": 2,
  "editor.insertSpaces": false,
  // "editor.fontFamily": "Source Han Code JP, monospace",
  "editor.fontFamily": "JetBrains Mono, Menlo, monospace",
  "editor.inlineSuggest.enabled": true,
  "editor.renderWhitespace": "boundary",
  "editor.experimentalEditContextEnabled": false,
  "editor.editContext": false, // vim 日本語問題
  "editor.accessibilitySupport": "off",
  // 目に優しい設定
  "editor.lineHeight": 1.6,
  "editor.cursorBlinking": "solid",
  "editor.smoothScrolling": true,

  // vimの設定
  // jjでノーマルモードに入る
  "vim.insertModeKeyBindings": [
      {
          "before": ["j","j"],
          "after": ["<Esc>"]
      }
  ],
  "vim.visualstar": true,
  "vim.hlsearch": true,
  "vim.easymotion": true,
  "vim.useCtrlKeys": true,
  "vim.useSystemClipboard": true,
  "vim.statusBarColorControl": false,
  "vim.visualModeKeyBindingsNonRecursive": [],
  "vim.normalModeKeyBindingsNonRecursive": [
    // ノーマルモードのときにxキー、sキーで削除した文字をヤンクしない
    {
      "before": [ "x" ],
      "after": [ "\"", "_", "x" ]
    },
    {
      "before": [ "s" ],
      "after": [ "\"", "_", "s" ]
    },
    {"before":["<leader>","h"],"after":["<C-w>","h"]},
    {"before":["<leader>","j"],"after":["<C-w>","j"]},
    {"before":["<leader>","k"],"after":["<C-w>","k"]},
    {"before":["<leader>","l"],"after":["<C-w>","l"]},
    // 前のタブを表示
    // { "before": ["C-h"], "commands": [ "workbench.action.previousEditor" ] },
    // 次のタブを表示
    // { "before": ["C-l"], "commands": [ "workbench.action.nextEditor" ] },
  ],
  // "editor.quickSuggestions": false,
  // "editor.wordSeparators": "/\\()\"':,.;<>~!@#$%^&*|+=[]{}`?_-、。「」【】『』（）！？　てにをはがのともへでや",

  "[markdown]": {
      "editor.tabSize": 2,
      "editor.insertSpaces": true
  },
  "[html]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
  },
  "[js]": {
      "editor.tabSize": 2
  },
  "[typescript]": {
      "editor.tabSize": 2,
      "editor.insertSpaces": true
  },
  "[typescriptreact]": {
      "editor.tabSize": 2,
      "editor.insertSpaces": true
  },
  "[vue]": {
      "editor.tabSize": 2
  },
  "[ruby]": {
      "editor.tabSize": 2
  },
  "[php]": {
      "editor.tabSize": 4
  },
  "[go]": {
      "editor.tabSize": 4,
      "editor.insertSpaces": false,
      "editor.snippetSuggestions": "none",
      "editor.formatOnSave": true,
      "editor.codeActionsOnSave": {
        "source.organizeImports": "explicit"
      },
  },
  "go.toolsManagement.autoUpdate": true,
  "go.useLanguageServer": true,
  "go.alternateTools": {
    "go-langserver": "gopls"
  },
  // For gopls
  // https://github.com/golang/tools/blob/master/gopls/doc/settings.md
  "gopls": {
    "hoverKind": "SynopsisDocumentation",
    "usePlaceholders": true,
    "linkTarget": "pkg.go.dev",
    "staticcheck": false,
    "completionDocumentation": true,
    "completeUnimported": true,
    "deepCompletion": true
  },
  "[dockercompose]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "editor.autoIndent": "advanced",
    "editor.quickSuggestions": {
      "other": true,
      "comments": false,
      "strings": true
    },
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "javascript.updateImportsOnFileMove.enabled": "always",
  "php.validate.executablePath": "",
  "accessibility.signalOptions.volume": 70,
  "accessibility.signalOptions.experimental.delays.general": {
    "announcement": 3000,
    "sound": 400
  },
  "accessibility.signalOptions.experimental.delays.errorAtPosition": {
    "announcement": 3000,
    "sound": 1000
  },
  "accessibility.signalOptions.experimental.delays.warningAtPosition": {
    "announcement": 3000,
    "sound": 1000
  },
  // git
  "git.autofetch": true,
  "git.openRepositoryInParentFolders": "never",
  "github.copilot.selectedCompletionModel": "",
  "github.copilot.nextEditSuggestions.enabled": true,
  "github.copilot.editor.enableAutoCompletions": true,
  "[github-actions-workflow]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },

  // 過去に有効で現在無効の設定
  "docker.extension.enableComposeLanguageServer": false,
  "docker.extension.dockerEngineAvailabilityPrompt": false,
  "alignment.chars": {
    ":": {
      "spaceBefore": 0,
      "spaceAfter": 1
    },
    "::": {
      "spaceBefore": 0,
      "spaceAfter": 0
    },
    "=": {
      "spaceBefore": 1,
      "spaceAfter": 1
    },
    "===": {
      "spaceBefore": 1,
      "spaceAfter": 1
    },
    "==": {
      "spaceBefore": 1,
      "spaceAfter": 1
    },
    "=>": {
      "spaceBefore": 1,
      "spaceAfter": 1
    },
    "+=": {
      "spaceBefore": 1,
      "spaceAfter": 1
    },
    "-=": {
      "spaceBefore": 1,
      "spaceAfter": 1
    },
    "*=": {
      "spaceBefore": 1,
      "spaceAfter": 1
    },
    "/=": {
      "spaceBefore": 1,
      "spaceAfter": 1
    }
  },
  "gitlens.ai.model": "vscode",
  "gitlens.ai.vscode.model": "copilot:gpt-4.1",
}
